                <!-- Incubation Schemes Section -->
                <div class="dashboard-section" id="section-incubation">
                    <section class="section">
                        <div class="section-header">
                            <h3 class="section-title">Incubation Schemes Management</h3>
                            <div class="section-actions">
                                <select class="filter-select" id="user-role-selector" onchange="simulateUserRole(this.value === 'admin' ? null : parseInt(this.value))" style="min-width: 150px;">
                                    <option value="admin">View as: Admin</option>
                                    <option value="1">View as: Arun Kumar</option>
                                    <option value="2">View as: Priya Sharma</option>
                                    <option value="3">View as: Rahul Verma</option>
                                </select>
                                <button class="button button-secondary" onclick="resetDemoData()">🔄 Reset Demo Data</button>
                                <button class="button button-primary" id="add-scheme-btn" onclick="openSchemeModal()">➕ Add New Scheme</button>
                            </div>
                        </div>

                        <!-- Summary Cards -->
                        <div class="summary-cards" style="margin-bottom: 24px;">
                            <div class="summary-card">
                                <div class="card-icon">📋</div>
                                <div class="card-label">Total Schemes</div>
                                <div class="card-value" id="total-schemes">0</div>
                            </div>
                            <div class="summary-card">
                                <div class="card-icon">✅</div>
                                <div class="card-label">Active Schemes</div>
                                <div class="card-value" id="active-schemes">0</div>
                            </div>
                            <div class="summary-card">
                                <div class="card-icon">📅</div>
                                <div class="card-label">Upcoming Schemes</div>
                                <div class="card-value" id="upcoming-schemes">0</div>
                            </div>
                            <div class="summary-card">
                                <div class="card-icon">⏰</div>
                                <div class="card-label">Expired Schemes</div>
                                <div class="card-value" id="expired-schemes">0</div>
                            </div>
                        </div>

                        <!-- Tabs -->
                        <div class="tab-switcher" style="margin-bottom: 24px;">
                            <button class="tab-button active" onclick="switchTab('schemes')">Schemes</button>
                            <button class="tab-button" onclick="switchTab('permissions')">Editing Permissions</button>
                        </div>

                        <!-- Schemes Tab -->
                        <div id="tab-schemes" class="tab-content active">
                            <div class="filter-bar">
                                <input type="text" class="filter-input" id="scheme-search" placeholder="Search schemes..." oninput="filterSchemes()">
                                <select class="filter-select" id="scheme-status-filter" onchange="filterSchemes()">
                                    <option value="all">All Status</option>
                                    <option value="active">Active</option>
                                    <option value="upcoming">Upcoming</option>
                                    <option value="expired">Expired</option>
                                </select>
                                <select class="filter-select" id="scheme-dept-filter" onchange="filterSchemes()">
                                    <option value="all">All Departments</option>
                                    <option value="CSE">CSE</option>
                                    <option value="ECE">ECE</option>
                                    <option value="ME">ME</option>
                                    <option value="EE">EE</option>
                                    <option value="CE">CE</option>
                                </select>
                            </div>

                            <div class="table-container">
                                <table class="data-table" id="schemes-table">
                                    <thead>
                                        <tr>
                                            <th>Scheme Name</th>
                                            <th>Department</th>
                                            <th>Application Period</th>
                                            <th>Status</th>
                                            <th>Last Updated</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="schemes-table-body">
                                        <!-- Schemes will be populated by JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

