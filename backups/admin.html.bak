        function openClubModal(clubId = null) {
            currentEditingClub = clubId ? clubs.find(c => c.id === clubId) : null;
            document.getElementById('club-modal-title').textContent = currentEditingClub ? 'Edit Club' : 'Create New Club';
            
            // Populate faculty dropdown
            const facultySelect = document.getElementById('club-faculty');
            facultySelect.innerHTML = '<option value="">Select Faculty</option>' + 
                staff.map(s => `<option value="${s.name}">${s.name}</option>`).join('');
            
            if (currentEditingClub) {
                document.getElementById('club-name').value = currentEditingClub.name;
                document.getElementById('club-category').value = currentEditingClub.category;
                document.getElementById('club-faculty').value = currentEditingClub.faculty;
                document.getElementById('club-lead').value = currentEditingClub.lead;
                document.getElementById('club-department').value = currentEditingClub.department;
                document.getElementById('club-status').value = currentEditingClub.status;
                document.getElementById('club-description').value = currentEditingClub.description || '';
            } else {
                document.getElementById('club-name').value = '';
                document.getElementById('club-category').value = 'Technical';
                document.getElementById('club-faculty').value = '';
                document.getElementById('club-lead').value = '';
                document.getElementById('club-department').value = 'CSE';
                document.getElementById('club-status').value = 'active';
                document.getElementById('club-description').value = '';
            }
            
            openModal('club-modal');
        }

        function closeClubModal() {
            closeModal('club-modal');
            currentEditingClub = null;
        }

        function saveClub() {
            const name = document.getElementById('club-name').value.trim();
            const category = document.getElementById('club-category').value;
            const faculty = document.getElementById('club-faculty').value;
            const lead = document.getElementById('club-lead').value.trim();
            const department = document.getElementById('club-department').value;
            const status = document.getElementById('club-status').value;
            const description = document.getElementById('club-description').value.trim();

            if (!name || !faculty || !lead) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            if (currentEditingClub) {
                const index = clubs.findIndex(c => c.id === currentEditingClub.id);
                clubs[index] = { ...clubs[index], name, category, faculty, lead, department, status, description };
                showToast('Club updated successfully', 'success');
            } else {
                clubs.push({ id: Date.now(), name, category, faculty, lead, department, status, description });
                showToast('Club created successfully', 'success');
            }

            renderClubs();
            closeClubModal();
        }

        function viewClub(id) {
            const c = clubs.find(cl => cl.id === id);
            if (!c) return;
            alert(`Club Details:\n\nName: ${c.name}\nCategory: ${c.category}\nFaculty In-charge: ${c.faculty}\nStudent Lead: ${c.lead}\nDepartment: ${c.department}\nStatus: ${capitalizeFirst(c.status)}\nDescription: ${c.description || 'N/A'}`);
        }

        function editClub(id) {
            openClubModal(id);
        }

        function deleteClub(id) {
            if (confirm('Are you sure you want to delete this club?')) {
                clubs = clubs.filter(c => c.id !== id);
                renderClubs();
                showToast('Club deleted successfully', 'success');
            }
        }

        // ========================================
        // Campus Blocks Management
        // ========================================
        
        let currentEditingBlock = null;

        function renderBlocks() {
            const tbody = document.getElementById('blocks-table-body');
            if (!tbody) return;
            
            tbody.innerHTML = blocks.map(b => `
                <tr>
                    <td>${b.name}</td>
                    <td>${b.code}</td>
                    <td>${b.type}</td>
                    <td>${b.floors}</td>
                    <td>${b.location}</td>
                    <td>${b.classrooms}</td>
                    <td><span class="status-badge status-${b.status}">${capitalizeFirst(b.status)}</span></td>
                    <td>
                        <a href="#" class="action-link" onclick="viewBlock(${b.id})">View</a>
                        <a href="#" class="action-link" onclick="editBlock(${b.id})">Edit</a>
                        <a href="#" class="action-link" onclick="deleteBlock(${b.id})">Delete</a>
                    </td>
                </tr>
            `).join('');
        }

        function openBlockModal(blockId = null) {
            currentEditingBlock = blockId ? blocks.find(b => b.id === blockId) : null;
            document.getElementById('block-modal-title').textContent = currentEditingBlock ? 'Edit Block' : 'Add New Block';
            
            if (currentEditingBlock) {
                document.getElementById('block-name').value = currentEditingBlock.name;
                document.getElementById('block-code').value = currentEditingBlock.code;
                document.getElementById('block-type').value = currentEditingBlock.type;
                document.getElementById('block-floors').value = currentEditingBlock.floors;
                document.getElementById('block-location').value = currentEditingBlock.location;
                document.getElementById('block-classrooms').value = currentEditingBlock.classrooms;
                document.getElementById('block-status').value = currentEditingBlock.status;
            } else {
                document.getElementById('block-name').value = '';
                document.getElementById('block-code').value = '';
                document.getElementById('block-type').value = 'Academic';
                document.getElementById('block-floors').value = '';
                document.getElementById('block-location').value = '';
                document.getElementById('block-classrooms').value = '';
                document.getElementById('block-status').value = 'active';
            }
            
            openModal('block-modal');
        }

        function closeBlockModal() {
            closeModal('block-modal');
            currentEditingBlock = null;
        }

        function saveBlock() {
            const name = document.getElementById('block-name').value.trim();
            const code = document.getElementById('block-code').value.trim();
            const type = document.getElementById('block-type').value;
            const floors = document.getElementById('block-floors').value;
            const location = document.getElementById('block-location').value.trim();
            const classrooms = document.getElementById('block-classrooms').value;
            const status = document.getElementById('block-status').value;

            if (!name || !code || !floors || !location || !classrooms) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            if (currentEditingBlock) {
                const index = blocks.findIndex(b => b.id === currentEditingBlock.id);
                blocks[index] = { ...blocks[index], name, code, type, floors, location, classrooms, status };
                showToast('Block updated successfully', 'success');
            } else {
                blocks.push({ id: Date.now(), name, code, type, floors, location, classrooms, status });
                showToast('Block added successfully', 'success');
            }

            renderBlocks();
            updateClassroomBlockDropdown();
            closeBlockModal();
        }

        function viewBlock(id) {
            const b = blocks.find(bl => bl.id === id);
            if (!b) return;
            alert(`Block Details:\n\nName: ${b.name}\nCode: ${b.code}\nType: ${b.type}\nFloors: ${b.floors}\nLocation: ${b.location}\nClassrooms: ${b.classrooms}\nStatus: ${capitalizeFirst(b.status)}`);
        }

        function editBlock(id) {
            openBlockModal(id);
        }

        function deleteBlock(id) {
            if (confirm('Are you sure you want to delete this block?')) {
                blocks = blocks.filter(b => b.id !== id);
                renderBlocks();
                updateClassroomBlockDropdown();
                showToast('Block deleted successfully', 'success');
            }
        }

        // ========================================
        // Classrooms Management
        // ========================================
        
        let currentEditingClassroom = null;

        function renderClassrooms() {
            const tbody = document.getElementById('classrooms-table-body');
            if (!tbody) return;
            
            tbody.innerHTML = classrooms.map(c => `
                <tr>
                    <td>${c.number}</td>
                    <td>${c.block}</td>
                    <td>${c.floor}</td>
                    <td>${c.type}</td>
                    <td>${c.capacity}</td>
                    <td>${c.department}</td>
                    <td><span class="status-badge status-${c.status === 'Available' ? 'active' : c.status === 'Occupied' ? 'pending' : 'inactive'}">${c.status}</span></td>
                    <td>
                        <a href="#" class="action-link" onclick="viewClassroom(${c.id})">View</a>
                        <a href="#" class="action-link" onclick="editClassroom(${c.id})">Edit</a>
                        <a href="#" class="action-link" onclick="deleteClassroom(${c.id})">Delete</a>
                    </td>
                </tr>
            `).join('');
        }

        function updateClassroomBlockDropdown() {
            const select = document.getElementById('classroom-block');
            if (!select) return;
            select.innerHTML = '<option value="">Select Block</option>' + 
                blocks.map(b => `<option value="${b.code}">${b.code} - ${b.name}</option>`).join('');
        }

        function openClassroomModal(classroomId = null) {
            currentEditingClassroom = classroomId ? classrooms.find(c => c.id === classroomId) : null;
            document.getElementById('classroom-modal-title').textContent = currentEditingClassroom ? 'Edit Classroom' : 'Add Classroom';
            
            updateClassroomBlockDropdown();
            
            if (currentEditingClassroom) {
                document.getElementById('classroom-number').value = currentEditingClassroom.number;
                document.getElementById('classroom-block').value = currentEditingClassroom.block;
                document.getElementById('classroom-floor').value = currentEditingClassroom.floor;
                document.getElementById('classroom-type').value = currentEditingClassroom.type;
                document.getElementById('classroom-capacity').value = currentEditingClassroom.capacity;
                document.getElementById('classroom-department').value = currentEditingClassroom.department;
                document.getElementById('classroom-status').value = currentEditingClassroom.status;
            } else {
                document.getElementById('classroom-number').value = '';
                document.getElementById('classroom-block').value = '';
                document.getElementById('classroom-floor').value = 'Ground Floor';
                document.getElementById('classroom-type').value = 'Lecture Hall';
                document.getElementById('classroom-capacity').value = '';
                document.getElementById('classroom-department').value = 'CSE';
                document.getElementById('classroom-status').value = 'Available';
            }
            
            openModal('classroom-modal');
        }

        function closeClassroomModal() {
            closeModal('classroom-modal');
            currentEditingClassroom = null;
        }

        function saveClassroom() {
            const number = document.getElementById('classroom-number').value.trim();
            const block = document.getElementById('classroom-block').value;
            const floor = document.getElementById('classroom-floor').value;
            const type = document.getElementById('classroom-type').value;
            const capacity = document.getElementById('classroom-capacity').value;
            const department = document.getElementById('classroom-department').value;
            const status = document.getElementById('classroom-status').value;

            if (!number || !block || !capacity) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            if (currentEditingClassroom) {
                const index = classrooms.findIndex(c => c.id === currentEditingClassroom.id);
                classrooms[index] = { ...classrooms[index], number, block, floor, type, capacity, department, status };
                showToast('Classroom updated successfully', 'success');
            } else {
                classrooms.push({ id: Date.now(), number, block, floor, type, capacity, department, status });
                showToast('Classroom added successfully', 'success');
            }

            renderClassrooms();
            closeClassroomModal();
        }

        function viewClassroom(id) {
            const c = classrooms.find(cl => cl.id === id);
            if (!c) return;
            alert(`Classroom Details:\n\nNumber: ${c.number}\nBlock: ${c.block}\nFloor: ${c.floor}\nType: ${c.type}\nCapacity: ${c.capacity}\nDepartment: ${c.department}\nStatus: ${c.status}`);
        }

        function editClassroom(id) {
            openClassroomModal(id);
        }

        function deleteClassroom(id) {
            if (confirm('Are you sure you want to delete this classroom?')) {
                classrooms = classrooms.filter(c => c.id !== id);
                renderClassrooms();
                showToast('Classroom deleted successfully', 'success');
            }
        }

        // ========================================
        // Settings Management
        // ========================================
        
        function saveSettings() {
            showToast('Settings saved successfully', 'success');
        }

        function closeSettingsModal() {
            closeModal('settings-modal');
        }

        // ========================================
        // Coordinator Assignment
        // ========================================
        
        function openCoordinatorAssignmentForm() {
            // Populate department dropdown
            const deptSelect = document.getElementById('coord-department');
            if (deptSelect) {
                deptSelect.innerHTML = '<option value="">Select Department</option>' + 
                    departments.map(d => `<option value="${d.code}">${d.name} (${d.code})</option>`).join('');
            }
            
            // Populate staff dropdown
            const staffSelect = document.getElementById('coord-staff');
            if (staffSelect) {
                staffSelect.innerHTML = '<option value="">Select Staff Member</option>' + 
                    staff.map(s => `<option value="${s.name}">${s.name} (${s.staffId})</option>`).join('');
            }
            
            // Scroll to form
            document.getElementById('coordinator-form-panel').scrollIntoView({ behavior: 'smooth' });
        }

        function clearCoordinatorForm() {
            if (document.getElementById('coord-department')) {
                document.getElementById('coord-department').value = '';
            }
            if (document.getElementById('coord-staff')) {
                document.getElementById('coord-staff').value = '';
            }
            if (document.getElementById('coord-designation')) {
                document.getElementById('coord-designation').value = '';
            }
        }

        function assignCoordinator() {
            const dept = document.getElementById('coord-department').value;
            const staffMember = document.getElementById('coord-staff').value;
            const designation = document.getElementById('coord-designation').value;

            if (!dept || !staffMember || !designation) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            // Check if department already has a coordinator
            const deptIndex = departments.findIndex(d => d.code === dept);
            if (deptIndex !== -1) {
                departments[deptIndex].coordinator = staffMember;
                showToast('Coordinator assigned successfully', 'success');
                renderDepartments();
                clearCoordinatorForm();
            } else {
                showToast('Department not found', 'error');
            }
        }

        function viewCoordinator(id) {
            const dept = departments.find(d => d.id === id);
            if (!dept) return;
            alert(`Coordinator Details:\n\nDepartment: ${dept.name}\nCoordinator: ${dept.coordinator || 'Not Assigned'}\nCode: ${dept.code}`);
        }

        function editCoordinator(id) {
            const dept = departments.find(d => d.id === id);
            if (!dept) return;
            openCoordinatorAssignmentForm();
            document.getElementById('coord-department').value = dept.code;
            document.getElementById('coord-staff').value = dept.coordinator || '';
            document.getElementById('coord-designation').value = 'Department Coordinator';
        }

        // ========================================
        // Initialize All Sections
        // ========================================
        
        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            renderStudents();
            renderStaff();
            renderDepartments();
            renderClubs();
            renderBlocks();
            renderClassrooms();
            updateClassroomBlockDropdown();
        });
    </script>

    <!-- ========================================
         Incubation Schemes Modals
         ========================================== -->

    <!-- Scheme Modal -->
    <div class="modal-overlay" id="scheme-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="scheme-modal-title">Add New Scheme</h3>
                <button class="modal-close" onclick="closeSchemeModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Scheme Name *</label>
                        <input type="text" class="form-input" id="scheme-name" placeholder="Enter scheme name">
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Scheme Description *</label>
                        <textarea class="form-textarea" id="scheme-description" placeholder="Enter scheme description"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Organizing Department *</label>
                        <select class="form-input" id="scheme-department">
                            <option value="CSE">CSE</option>
                            <option value="ECE">ECE</option>
                            <option value="ME">ME</option>
                            <option value="EE">EE</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Eligibility Criteria *</label>
                        <input type="text" class="form-input" id="scheme-eligibility" placeholder="Enter eligibility criteria">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Application Start Date *</label>
                        <input type="date" class="form-input" id="scheme-start-date">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Application Deadline *</label>
                        <input type="date" class="form-input" id="scheme-deadline">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Scheme Status *</label>
                        <select class="form-input" id="scheme-status">
                            <option value="upcoming">Upcoming</option>
                            <option value="active">Active</option>
                            <option value="expired">Expired</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Application Link (Optional)</label>
                        <input type="url" class="form-input" id="scheme-link" placeholder="https://example.com">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Image/Banner URL (Optional)</label>
                        <input type="url" class="form-input" id="scheme-image" placeholder="https://example.com/image.jpg">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeSchemeModal()">Cancel</button>
                <button class="button button-primary" onclick="saveScheme()">Save Scheme</button>
            </div>
        </div>
    </div>

    <!-- View Scheme Modal -->
    <div class="modal-overlay" id="view-scheme-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Scheme Details</h3>
                <button class="modal-close" onclick="closeViewSchemeModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Scheme Name</label>
                        <div style="font-size: 16px; font-weight: 600; color: var(--color-charcoal);" id="view-scheme-name"></div>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Description</label>
                        <div style="font-size: 14px; color: var(--color-charcoal); line-height: 1.6;" id="view-scheme-description"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department</label>
                        <div style="font-size: 14px; color: var(--color-charcoal);" id="view-scheme-department"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Eligibility</label>
                        <div style="font-size: 14px; color: var(--color-charcoal);" id="view-scheme-eligibility"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Application Period</label>
                        <div style="font-size: 14px; color: var(--color-charcoal);" id="view-scheme-period"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <div style="font-size: 14px; color: var(--color-charcoal);" id="view-scheme-status"></div>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Application Link</label>
                        <a id="view-scheme-link" href="#" target="_blank" style="color: var(--color-maroon); text-decoration: none;">Not provided</a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-primary" onclick="closeViewSchemeModal()">Close</button>
            </div>
        </div>
    </div>

    <!-- Permission Modal -->
    <div class="modal-overlay" id="permission-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="permission-modal-title">Grant Coordinator Access</h3>
                <button class="modal-close" onclick="closePermissionModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Select Club Coordinator *</label>
                        <select class="form-input" id="permission-coordinator">
                            <option value="">Select Coordinator</option>
                        </select>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Assign Schemes *</label>
                        <div class="multi-select-container">
                            <button class="button button-secondary" onclick="toggleSchemeDropdown()" style="width: 100%; justify-content: space-between;">
                                <span>Select Schemes</span>
                                <span>▼</span>
                            </button>
                            <div class="multi-select-dropdown" id="scheme-dropdown">
                            </div>
                        </div>
                        <div class="selected-schemes" id="selected-schemes-container"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closePermissionModal()">Cancel</button>
                <button class="button button-primary" onclick="savePermission()">Grant Access</button>
            </div>
        </div>
    </div>

    <!-- Import Students Modal -->
    <div class="modal-overlay" id="import-students-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Import Students from CSV</h3>
                <button class="modal-close" onclick="closeImportStudentsModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Select CSV File</label>
                    <input type="file" class="form-input" id="csv-file-input" accept=".csv">
                    <p style="margin-top: 8px; font-size: 12px; color: var(--color-gray-medium);">
                        CSV format: Name, Roll Number, Email, Department, Year, Status
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeImportStudentsModal()">Cancel</button>
                <button class="button button-primary" onclick="importStudents()">Import</button>
            </div>
        </div>
    </div>

    <!-- Student Modal -->
    <div class="modal-overlay" id="student-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="student-modal-title">Add Student</h3>
                <button class="modal-close" onclick="closeStudentModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Student Name *</label>
                        <input type="text" class="form-input" id="student-name" placeholder="Enter student name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Roll Number *</label>
                        <input type="text" class="form-input" id="student-roll" placeholder="Enter roll number">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-input" id="student-email" placeholder="Enter email">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department *</label>
                        <select class="form-input" id="student-department">
                            <option value="CSE">CSE</option>
                            <option value="ECE">ECE</option>
                            <option value="ME">ME</option>
                            <option value="EE">EE</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Year/Semester *</label>
                        <select class="form-input" id="student-year">
                            <option value="1st Year / 1st Sem">1st Year / 1st Sem</option>
                            <option value="1st Year / 2nd Sem">1st Year / 2nd Sem</option>
                            <option value="2nd Year / 3rd Sem">2nd Year / 3rd Sem</option>
                            <option value="2nd Year / 4th Sem">2nd Year / 4th Sem</option>
                            <option value="3rd Year / 5th Sem">3rd Year / 5th Sem</option>
                            <option value="3rd Year / 6th Sem">3rd Year / 6th Sem</option>
                            <option value="4th Year / 7th Sem">4th Year / 7th Sem</option>
                            <option value="4th Year / 8th Sem">4th Year / 8th Sem</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status *</label>
                        <select class="form-input" id="student-status">
                            <option value="active">Active</option>
                            <option value="pending">Pending</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeStudentModal()">Cancel</button>
                <button class="button button-primary" onclick="saveStudent()">Save Student</button>
            </div>
        </div>
    </div>

    <!-- Import Students Modal -->
    <div class="modal-overlay" id="import-students-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Import Students from CSV</h3>
                <button class="modal-close" onclick="closeImportStudentsModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label">Select CSV File</label>
                    <input type="file" class="form-input" id="csv-file-input" accept=".csv">
                </div>
                <p style="font-size: 13px; color: var(--color-gray-medium); margin-top: 12px;">
                    CSV format: Name,Roll Number,Email,Department,Year,Status
                </p>
                <p style="font-size: 12px; color: var(--color-gray-medium); margin-top: 8px;">
                    Example: John Doe,CSE2021001,john@email.com,CSE,3rd Year / 5th Sem,active
                </p>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeImportStudentsModal()">Cancel</button>
                <button class="button button-primary" onclick="importStudents()">Import</button>
            </div>
        </div>
    </div>

    <!-- Staff Modal -->
    <div class="modal-overlay" id="staff-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="staff-modal-title">Add Staff</h3>
                <button class="modal-close" onclick="closeStaffModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Staff Name *</label>
                        <input type="text" class="form-input" id="staff-name" placeholder="Enter staff name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Staff ID *</label>
                        <input type="text" class="form-input" id="staff-id" placeholder="Enter staff ID">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-input" id="staff-email" placeholder="Enter email">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department *</label>
                        <select class="form-input" id="staff-department">
                            <option value="CSE">CSE</option>
                            <option value="ECE">ECE</option>
                            <option value="ME">ME</option>
                            <option value="EE">EE</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Designation *</label>
                        <select class="form-input" id="staff-designation">
                            <option value="Professor">Professor</option>
                            <option value="Associate Professor">Associate Professor</option>
                            <option value="Assistant Professor">Assistant Professor</option>
                            <option value="Lecturer">Lecturer</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status *</label>
                        <select class="form-input" id="staff-status">
                            <option value="active">Active</option>
                            <option value="pending">Pending</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeStaffModal()">Cancel</button>
                <button class="button button-primary" onclick="saveStaff()">Save Staff</button>
            </div>
        </div>
    </div>

    <!-- Department Modal -->
    <div class="modal-overlay" id="department-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="department-modal-title">Add Department</h3>
                <button class="modal-close" onclick="closeDepartmentModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Department Name *</label>
                        <input type="text" class="form-input" id="dept-name" placeholder="Enter department name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department Code *</label>
                        <input type="text" class="form-input" id="dept-code" placeholder="e.g., CSE">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Coordinator</label>
                        <select class="form-input" id="dept-coordinator">
                            <option value="">Select Coordinator</option>
                        </select>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Description</label>
                        <textarea class="form-textarea" id="dept-description" placeholder="Enter department description"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeDepartmentModal()">Cancel</button>
                <button class="button button-primary" onclick="saveDepartment()">Save Department</button>
            </div>
        </div>
    </div>

    <!-- Club Modal -->
    <div class="modal-overlay" id="club-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="club-modal-title">Create New Club</h3>
                <button class="modal-close" onclick="closeClubModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Club Name *</label>
                        <input type="text" class="form-input" id="club-name" placeholder="Enter club name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Club Category *</label>
                        <select class="form-input" id="club-category">
                            <option value="Technical">Technical</option>
                            <option value="Cultural">Cultural</option>
                            <option value="Arts">Arts</option>
                            <option value="Sports">Sports</option>
                            <option value="Social">Social</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Faculty In-charge *</label>
                        <select class="form-input" id="club-faculty">
                            <option value="">Select Faculty</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Student Lead *</label>
                        <input type="text" class="form-input" id="club-lead" placeholder="Enter student name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department *</label>
                        <select class="form-input" id="club-department">
                            <option value="CSE">CSE</option>
                            <option value="ECE">ECE</option>
                            <option value="ME">ME</option>
                            <option value="EE">EE</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status *</label>
                        <select class="form-input" id="club-status">
                            <option value="active">Active</option>
                            <option value="pending">Pending</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label class="form-label">Description</label>
                        <textarea class="form-textarea" id="club-description" placeholder="Enter club description"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeClubModal()">Cancel</button>
                <button class="button button-primary" onclick="saveClub()">Save Club</button>
            </div>
        </div>
    </div>

    <!-- Block Modal -->
    <div class="modal-overlay" id="block-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="block-modal-title">Add New Block</h3>
                <button class="modal-close" onclick="closeBlockModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Block Name *</label>
                        <input type="text" class="form-input" id="block-name" placeholder="Enter block name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Block Code *</label>
                        <input type="text" class="form-input" id="block-code" placeholder="e.g., BLK-F">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Building Type *</label>
                        <select class="form-input" id="block-type">
                            <option value="Academic">Academic</option>
                            <option value="Laboratory">Laboratory</option>
                            <option value="Administrative">Administrative</option>
                            <option value="Library">Library</option>
                            <option value="Sports">Sports</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Number of Floors *</label>
                        <input type="number" class="form-input" id="block-floors" placeholder="Enter number of floors">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Location *</label>
                        <input type="text" class="form-input" id="block-location" placeholder="e.g., North Campus">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Classrooms *</label>
                        <input type="number" class="form-input" id="block-classrooms" placeholder="Enter classroom count">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status *</label>
                        <select class="form-input" id="block-status">
                            <option value="active">Active</option>
                            <option value="pending">Pending</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeBlockModal()">Cancel</button>
                <button class="button button-primary" onclick="saveBlock()">Save Block</button>
            </div>
        </div>
    </div>

    <!-- Classroom Modal -->
    <div class="modal-overlay" id="classroom-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title" id="classroom-modal-title">Add Classroom</h3>
                <button class="modal-close" onclick="closeClassroomModal()">×</button>
            </div>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Classroom Number *</label>
                        <input type="text" class="form-input" id="classroom-number" placeholder="e.g., CR-105">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Block *</label>
                        <select class="form-input" id="classroom-block">
                            <option value="">Select Block</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Floor *</label>
                        <select class="form-input" id="classroom-floor">
                            <option value="Ground Floor">Ground Floor</option>
                            <option value="1st Floor">1st Floor</option>
                            <option value="2nd Floor">2nd Floor</option>
                            <option value="3rd Floor">3rd Floor</option>
                            <option value="4th Floor">4th Floor</option>
                            <option value="5th Floor">5th Floor</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Room Type *</label>
                        <select class="form-input" id="classroom-type">
                            <option value="Lecture Hall">Lecture Hall</option>
                            <option value="Laboratory">Laboratory</option>
                            <option value="Seminar Room">Seminar Room</option>
                            <option value="Conference Room">Conference Room</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Seating Capacity *</label>
                        <input type="number" class="form-input" id="classroom-capacity" placeholder="Enter capacity">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Department *</label>
                        <select class="form-input" id="classroom-department">
                            <option value="CSE">CSE</option>
                            <option value="ECE">ECE</option>
                            <option value="ME">ME</option>
                            <option value="EE">EE</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status *</label>
                        <select class="form-input" id="classroom-status">
                            <option value="Available">Available</option>
                            <option value="Occupied">Occupied</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button button-secondary" onclick="closeClassroomModal()">Cancel</button>
                <button class="button button-primary" onclick="saveClassroom()">Save Classroom</button>
            </div>
        </div>
    </div>

    <!-- Settings Save Modal -->
    <div class="modal-overlay" id="settings-modal">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Save Settings</h3>
                <button class="modal-close" onclick="closeSettingsModal()">×</button>
            </div>
            <div class="modal-body">
                <p style="color: var(--color-charcoal);">Settings have been saved successfully!</p>
            </div>
            <div class="modal-footer">
                <button class="button button-primary" onclick="closeSettingsModal()">OK</button>
            </div>
        </div>
    </div>
</body>
</html>