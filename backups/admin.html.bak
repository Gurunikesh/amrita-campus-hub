<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - University Technology Portal</title>
    
    <!-- ==========================================
         Internal CSS Styles
         ========================================== -->
    <style>
        /* ========================================
           CSS Variables (Color Palette)
           ======================================== */
        :root {
            --color-maroon: #741C32;
            --color-amber: #D99A22;
            --color-warm-bg: #F7F5F2;
            --color-charcoal: #25232A;
            --color-white: #FFFFFF;
            --color-maroon-dark: #5A1425;
            --color-amber-light: #E8B948;
            --color-gray-light: #E8E6E3;
            --color-gray-medium: #A8A6A3;
            --color-success: #2E7D32;
            --color-warning: #F57C00;
            --color-danger: #C62828;
            --shadow-soft: 0 4px 20px rgba(37, 35, 42, 0.08);
            --shadow-card: 0 8px 32px rgba(37, 35, 42, 0.12);
            --shadow-hover: 0 12px 40px rgba(37, 35, 42, 0.16);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --transition-fast: 0.2s ease;
            --transition-medium: 0.3s ease;
            --sidebar-width: 260px;
            --header-height: 70px;
        }

        /* ========================================
           CSS Reset & Base Styles
           ======================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--color-warm-bg);
            color: var(--color-charcoal);
            line-height: 1.6;
            height: 100vh;
            overflow: hidden;
        }

        /* ========================================
           Dashboard Layout
           ======================================== */
        .dashboard {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ========================================
           Sidebar Navigation
           ======================================== */
        .sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, var(--color-maroon) 0%, var(--color-maroon-dark) 100%);
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 1000;
            padding: 24px 0;
            transition: transform var(--transition-medium);
        }

        .sidebar-logo {
            padding: 0 24px 32px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 24px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background: var(--color-white);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
        }

        .logo-icon::before {
            content: 'UT';
            font-size: 18px;
            font-weight: 700;
            color: var(--color-maroon);
        }

        .sidebar-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--color-white);
            letter-spacing: 0.5px;
        }

        .sidebar-subtitle {
            font-size: 12px;
            color: var(--color-amber);
            margin-top: 4px;
        }

        .sidebar-nav {
            padding: 0 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 14px 16px;
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            border-radius: var(--radius-md);
            margin-bottom: 4px;
            transition: all var(--transition-fast);
            font-size: 14px;
            font-weight: 500;
        }

        .nav-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: var(--color-white);
        }

        .nav-item.active {
            background: linear-gradient(135deg, var(--color-amber) 0%, var(--color-amber-light) 100%);
            color: var(--color-maroon);
            font-weight: 600;
        }

        .nav-icon {
            width: 20px;
            height: 20px;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        /* ========================================
           Main Content Area
           ======================================== */
        .main-content {
            flex: 1;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* ========================================
           Top Header
           ======================================== */
        .header {
            height: var(--header-height);
            background-color: var(--color-white);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            flex-shrink: 0;
            z-index: 100;
            box-shadow: var(--shadow-soft);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .header-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--color-charcoal);
        }

        .search-box {
            position: relative;
            width: 300px;
        }

        .search-input {
            width: 100%;
            padding: 12px 16px 12px 44px;
            font-size: 14px;
            color: var(--color-charcoal);
            background-color: var(--color-warm-bg);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            transition: all var(--transition-fast);
            outline: none;
        }

        .search-input::placeholder {
            color: var(--color-gray-medium);
        }

        .search-input:focus {
            border-color: var(--color-maroon);
            background-color: var(--color-white);
            box-shadow: 0 0 0 4px rgba(116, 28, 50, 0.1);
        }

        .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            color: var(--color-gray-medium);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .notification-icon {
            width: 44px;
            height: 44px;
            background-color: var(--color-warm-bg);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all var(--transition-fast);
            position: relative;
        }

        .notification-icon:hover {
            background-color: var(--color-gray-light);
        }

        .notification-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 10px;
            height: 10px;
            background-color: var(--color-amber);
            border-radius: 50%;
            border: 2px solid var(--color-white);
        }

        .profile-area {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 16px;
            background-color: var(--color-warm-bg);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .profile-area:hover {
            background-color: var(--color-gray-light);
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--color-maroon) 0%, var(--color-maroon-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-white);
            font-weight: 600;
            font-size: 14px;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--color-charcoal);
        }

        /* ========================================
           Content Container
           ======================================== */
        .content {
            padding: 32px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* ========================================
           Section Visibility
           ======================================== */
        .dashboard-section {
            display: none;
        }

        .dashboard-section.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ========================================
           Mobile Menu Toggle
           ======================================== */
        .menu-toggle {
            display: none;
            width: 44px;
            height: 44px;
            background-color: var(--color-warm-bg);
            border-radius: var(--radius-md);
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 20px;
            margin-right: 12px;
            transition: all var(--transition-fast);
        }

        .menu-toggle:hover {
            background-color: var(--color-gray-light);
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        .sidebar-overlay.active {
            display: block;
        }

        .welcome-section {
            margin-bottom: 32px;
        }

        .welcome-title {
            font-size: 28px;
            font-weight: 700;
            color: var(--color-charcoal);
            margin-bottom: 8px;
        }

        .welcome-subtitle {
            font-size: 16px;
            color: var(--color-gray-medium);
        }

        .demo-notice {
            display: inline-block;
            padding: 8px 16px;
            background-color: var(--color-amber);
            color: var(--color-maroon);
            font-size: 13px;
            font-weight: 600;
            border-radius: var(--radius-md);
            margin-top: 12px;
        }

        /* ========================================
           Summary Cards
           ======================================== */
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }

        .summary-card {
            background-color: var(--color-white);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-card);
            transition: all var(--transition-medium);
            position: relative;
            overflow: hidden;
        }

        .summary-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .summary-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--color-maroon) 0%, var(--color-amber) 100%);
        }

        .card-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--color-maroon) 0%, var(--color-maroon-dark) 100%);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            font-size: 20px;
            color: var(--color-white);
        }

        .card-label {
            font-size: 14px;
            color: var(--color-gray-medium);
            font-weight: 500;
            margin-bottom: 8px;
        }

        .card-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--color-charcoal);
        }

        .card-trend {
            font-size: 13px;
            color: var(--color-success);
            margin-top: 8px;
            font-weight: 500;
        }

        /* ========================================
           Section Styling
           ======================================== */
        .section {
            background-color: var(--color-white);
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: var(--shadow-card);
            margin-bottom: 32px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--color-charcoal);
        }

        .section-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .button {
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .button-primary {
            background: linear-gradient(135deg, var(--color-maroon) 0%, var(--color-maroon-dark) 100%);
            color: var(--color-white);
        }

        .button-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-soft);
        }

        .button-secondary {
            background-color: var(--color-warm-bg);
            color: var(--color-charcoal);
            border: 2px solid var(--color-gray-light);
        }

        .button-secondary:hover {
            background-color: var(--color-gray-light);
            border-color: var(--color-gray-medium);
        }

        .filter-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .filter-input {
            padding: 10px 16px;
            font-size: 14px;
            color: var(--color-charcoal);
            background-color: var(--color-warm-bg);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            min-width: 200px;
            outline: none;
            transition: all var(--transition-fast);
        }

        .filter-input:focus {
            border-color: var(--color-maroon);
            background-color: var(--color-white);
            box-shadow: 0 0 0 4px rgba(116, 28, 50, 0.1);
        }

        .filter-select {
            padding: 10px 16px;
            font-size: 14px;
            color: var(--color-charcoal);
            background-color: var(--color-warm-bg);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            min-width: 180px;
            outline: none;
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .filter-select:focus {
            border-color: var(--color-maroon);
            background-color: var(--color-white);
            box-shadow: 0 0 0 4px rgba(116, 28, 50, 0.1);
        }

        /* ========================================
           Table Styling
           ======================================== */
        .table-container {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            padding: 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: var(--color-gray-medium);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--color-gray-light);
            background-color: var(--color-warm-bg);
        }

        .data-table td {
            padding: 16px;
            font-size: 14px;
            color: var(--color-charcoal);
            border-bottom: 1px solid var(--color-gray-light);
        }

        .data-table tr:hover {
            background-color: var(--color-warm-bg);
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: var(--radius-sm);
        }

        .status-active {
            background-color: rgba(46, 125, 50, 0.1);
            color: var(--color-success);
        }

        .status-inactive {
            background-color: rgba(198, 40, 40, 0.1);
            color: var(--color-danger);
        }

        .status-pending {
            background-color: rgba(245, 124, 0, 0.1);
            color: var(--color-warning);
        }

        .action-link {
            color: var(--color-maroon);
            text-decoration: none;
            font-weight: 500;
            font-size: 13px;
            margin-right: 12px;
            transition: color var(--transition-fast);
        }

        .action-link:hover {
            color: var(--color-maroon-dark);
            text-decoration: underline;
        }

        .action-link:last-child {
            margin-right: 0;
        }

        /* ========================================
           Form Panel Styling
           ======================================== */
        .form-panel {
            background-color: var(--color-warm-bg);
            border-radius: var(--radius-md);
            padding: 24px;
            margin-top: 24px;
            border: 2px dashed var(--color-gray-light);
        }

        .form-panel-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--color-charcoal);
            margin-bottom: 16px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--color-charcoal);
            margin-bottom: 8px;
        }

        .form-input {
            padding: 10px 14px;
            font-size: 14px;
            color: var(--color-charcoal);
            background-color: var(--color-white);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            outline: none;
            transition: all var(--transition-fast);
        }

        .form-input:focus {
            border-color: var(--color-maroon);
            box-shadow: 0 0 0 4px rgba(116, 28, 50, 0.1);
        }

        .form-textarea {
            padding: 10px 14px;
            font-size: 14px;
            color: var(--color-charcoal);
            background-color: var(--color-white);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            outline: none;
            transition: all var(--transition-fast);
            resize: vertical;
            min-height: 80px;
        }

        .form-textarea:focus {
            border-color: var(--color-maroon);
            box-shadow: 0 0 0 4px rgba(116, 28, 50, 0.1);
        }

        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        /* ========================================
           Department Stats Subsection
           ======================================== */
        .subsection {
            margin-top: 32px;
            padding-top: 32px;
            border-top: 2px solid var(--color-gray-light);
        }

        .subsection-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--color-charcoal);
            margin-bottom: 16px;
        }

        .dept-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .dept-stat-card {
            background-color: var(--color-warm-bg);
            border-radius: var(--radius-md);
            padding: 16px;
            text-align: center;
        }

        .dept-stat-name {
            font-size: 14px;
            color: var(--color-gray-medium);
            margin-bottom: 8px;
        }

        .dept-stat-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--color-maroon);
        }

        /* ========================================
           Responsive Design - Tablet
           ======================================== */
        @media (max-width: 1024px) {
            .sidebar {
                width: 220px;
            }

            .main-content {
                margin-left: 220px;
            }

            .header {
                padding: 0 24px;
            }

            .search-box {
                width: 240px;
            }

            .content {
                padding: 24px;
            }

            .summary-cards {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 16px;
            }

            .section {
                padding: 24px;
            }
        }

        /* ========================================
           Responsive Design - Mobile
           ======================================== */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .menu-toggle {
                display: flex;
            }

            .header {
                padding: 0 16px;
                height: 60px;
            }

            .header-left {
                gap: 16px;
            }

            .header-title {
                font-size: 16px;
            }

            .search-box {
                display: none;
            }

            .header-right {
                gap: 8px;
            }

            .profile-name {
                display: none;
            }

            .content {
                padding: 16px;
            }

            .welcome-title {
                font-size: 22px;
            }

            .welcome-subtitle {
                font-size: 14px;
            }

            .summary-cards {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .section {
                padding: 20px;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .section-title {
                font-size: 18px;
            }

            .section-actions {
                width: 100%;
            }

            .button {
                flex: 1;
                justify-content: center;
            }

            .filter-bar {
                flex-direction: column;
            }

            .filter-input,
            .filter-select {
                width: 100%;
                min-width: auto;
            }

            .data-table th,
            .data-table td {
                padding: 12px 8px;
                font-size: 13px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ========================================
           Responsive Design - Small Mobile
           ======================================== */
        @media (max-width: 480px) {
            .header {
                padding: 0 12px;
            }

            .content {
                padding: 12px;
            }

            .welcome-title {
                font-size: 18px;
            }

            .summary-card {
                padding: 20px;
            }

            .card-value {
                font-size: 28px;
            }

            .section {
                padding: 16px;
            }

            .section-title {
                font-size: 16px;
            }

            .button {
                padding: 10px 16px;
                font-size: 13px;
            }

            .table-container {
                font-size: 12px;
            }
        }

        /* ========================================
           Accessibility Focus Styles
           ======================================== */
        :focus-visible {
            outline: 2px solid var(--color-amber);
            outline-offset: 2px;
        }

        /* ========================================
           Scrollbar Styling
           ======================================== */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }

        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }

        /* ========================================
           Tab Switcher
           ======================================== */
        .tab-switcher {
            display: flex;
            background-color: var(--color-gray-light);
            border-radius: var(--radius-md);
            padding: 4px;
            gap: 4px;
        }

        .tab-button {
            flex: 1;
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            color: var(--color-charcoal);
            background: none;
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .tab-button:hover {
            background-color: rgba(116, 28, 50, 0.05);
        }

        .tab-button.active {
            background: linear-gradient(135deg, var(--color-maroon) 0%, var(--color-maroon-dark) 100%);
            color: var(--color-white);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        /* ========================================
           Modal Styles
           ======================================== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background-color: var(--color-white);
            border-radius: var(--radius-lg);
            max-width: 700px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-card);
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            padding: 24px;
            border-bottom: 2px solid var(--color-gray-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--color-charcoal);
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 24px;
            color: var(--color-gray-medium);
            cursor: pointer;
            padding: 8px;
            transition: color var(--transition-fast);
        }

        .modal-close:hover {
            color: var(--color-maroon);
        }

        .modal-body {
            padding: 24px;
        }

        .modal-footer {
            padding: 24px;
            border-top: 2px solid var(--color-gray-light);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        /* ========================================
           Multi-select Styles
           ======================================== */
        .multi-select-container {
            position: relative;
        }

        .multi-select-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background-color: var(--color-white);
            border: 2px solid var(--color-gray-light);
            border-radius: var(--radius-md);
            margin-top: 4px;
            max-height: 200px;
            overflow-y: auto;
            z-index: 10;
            box-shadow: var(--shadow-soft);
        }

        .multi-select-dropdown.active {
            display: block;
        }

        .multi-select-option {
            padding: 10px 14px;
            cursor: pointer;
            transition: background-color var(--transition-fast);
        }

        .multi-select-option:hover {
            background-color: var(--color-warm-bg);
        }

        .multi-select-option.selected {
            background-color: rgba(116, 28, 50, 0.1);
        }

        .selected-schemes {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }

        .scheme-tag {
            background-color: var(--color-maroon);
            color: var(--color-white);
            padding: 4px 12px;
            border-radius: var(--radius-sm);
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .scheme-tag-remove {
            cursor: pointer;
            font-weight: bold;
        }

        /* ========================================
           Toast Notification
           ======================================== */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 16px 24px;
            border-radius: var(--radius-md);
            color: var(--color-white);
            font-weight: 600;
            z-index: 3000;
            animation: slideIn 0.3s ease;
            box-shadow: var(--shadow-hover);
        }

        .toast.success {
            background-color: var(--color-success);
        }

        .toast.error {
            background-color: var(--color-danger);
        }

        .toast.warning {
            background-color: var(--color-warning);
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ========================================
           Status-specific badges
           ======================================== */
        .status-badge-upcoming {
            background-color: rgba(245, 124, 0, 0.1);
            color: var(--color-warning);
        }

        .status-badge-active {
            background-color: rgba(46, 125, 50, 0.1);
            color: var(--color-success);
        }

        .status-badge-expired {
            background-color: rgba(198, 40, 40, 0.1);
            color: var(--color-danger);
        }

        .status-badge-granted {
            background-color: rgba(46, 125, 50, 0.1);
            color: var(--color-success);
        }

        .status-badge-revoked {
            background-color: rgba(198, 40, 40, 0.1);
            color: var(--color-danger);
        }
    </style>
</head>
<body>
