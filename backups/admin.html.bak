                </div>

                <!-- Settings Section -->
                <div class="dashboard-section" id="section-settings">
                    <section class="section">
                        <div class="section-header">
                            <h3 class="section-title">Settings</h3>
                        </div>
                        <div class="form-panel">
                            <h4 class="form-panel-title">Administrative Preferences</h4>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Admin Email</label>
                                    <input type="email" class="form-input" placeholder="admin@university.edu">
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Notification Email</label>
                                    <input type="email" class="form-input" placeholder="notifications@university.edu">
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Timezone</label>
                                    <select class="form-input">
                                        <option>IST (UTC+5:30)</option>
                                        <option>UTC</option>
                                        <option>EST (UTC-5)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Language</label>
                                    <select class="form-input">
                                        <option>English</option>
                                        <option>Hindi</option>
                                        <option>Tamil</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-actions">
                                <button class="button button-primary" onclick="saveSettings()">Save Settings</button>
                                <button class="button button-secondary" onclick="alert('Settings reset to default values')">Cancel</button>
                            </div>
                            <p style="margin-top: 12px; font-size: 12px; color: var(--color-gray-medium);">
                                * Settings will be saved after backend integration
                            </p>
                        </div>
                    </section>
                </div>

            </div>
        </main>
    </div>

    <!-- ========================================
         JavaScript for Navigation
         ========================================== -->
    <script>
        // Section Navigation
        document.addEventListener('DOMContentLoaded', function() {
            const navItems = document.querySelectorAll('.nav-item');
            const sections = document.querySelectorAll('.dashboard-section');
            const menuToggle = document.querySelector('.menu-toggle');
            const sidebar = document.querySelector('.sidebar');
            const sidebarOverlay = document.querySelector('.sidebar-overlay');
            const headerTitle = document.querySelector('.header-title');

            // Section titles mapping
            const sectionTitles = {
                'overview': 'Admin Dashboard',
                'students': 'Student Management',
                'staff': 'Staff Management',
                'departments': 'Department Management',
                'coordinators': 'Coordinator Management',
                'clubs': 'Club Management',
                'incubation': 'Incubation Schemes Management',
                'blocks': 'Campus Block Management',
                'classrooms': 'Classroom Management',
                'settings': 'Settings'
            };

            // Navigation click handler
            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetSection = this.getAttribute('data-section');
                    
                    // Update active nav item
                    navItems.forEach(nav => nav.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Hide all sections
                    sections.forEach(section => section.classList.remove('active'));
                    
                    // Show target section
                    const targetSectionElement = document.getElementById('section-' + targetSection);
                    if (targetSectionElement) {
                        targetSectionElement.classList.add('active');
                    }
                    
                    // Update header title
                    if (sectionTitles[targetSection]) {
                        headerTitle.textContent = sectionTitles[targetSection];
                    }
                    
                    // Close mobile sidebar
                    if (window.innerWidth <= 768) {
                        sidebar.classList.remove('active');
                        sidebarOverlay.classList.remove('active');
                    }
                });
            });

            // Mobile menu toggle
            if (menuToggle) {
                menuToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                    sidebarOverlay.classList.toggle('active');
                });
            }

            // Close sidebar when clicking overlay
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                });
            }

            // Handle window resize
            window.addEventListener('resize', function() {
                if (window.innerWidth > 768) {
                    sidebar.classList.remove('active');
                    sidebarOverlay.classList.remove('active');
                }
            });
        });

        // ========================================
        // Incubation Schemes Management
        // ========================================

        // Demo data for schemes
        const defaultSchemes = [
            {
                id: 1,
                name: 'Startup Innovation Grant',
                description: 'Funding for student-led startup ideas',
                department: 'CSE',
                eligibility: 'Students with innovative startup ideas',
                startDate: '2024-01-15',
                deadline: '2024-03-31',
                status: 'active',
                applicationLink: 'https://university.edu/startup-grant',
                imageUrl: '',
                lastUpdated: '2024-01-20'
            },
            {
                id: 2,
                name: 'Research Incubation Program',
                description: 'Support for research-based projects',
                department: 'ECE',
                eligibility: 'Final year students with research projects',
                startDate: '2024-02-01',
                deadline: '2024-04-30',
                status: 'active',
                applicationLink: 'https://university.edu/research-incubation',
                imageUrl: '',
                lastUpdated: '2024-02-05'
            },
            {
                id: 3,
                name: 'Tech Entrepreneurship Bootcamp',
                description: 'Intensive bootcamp for aspiring entrepreneurs',
                department: 'ME',
                eligibility: 'All students interested in entrepreneurship',
                startDate: '2024-05-01',
                deadline: '2024-06-15',
                status: 'upcoming',
                applicationLink: 'https://university.edu/bootcamp',
                imageUrl: '',
                lastUpdated: '2024-01-25'
            },
            {
                id: 4,
                name: 'Innovation Challenge 2023',
                description: 'Annual innovation competition',
                department: 'EE',
                eligibility: 'Undergraduate students',
                startDate: '2023-09-01',
                deadline: '2023-12-31',
                status: 'expired',
                applicationLink: '',
                imageUrl: '',
                lastUpdated: '2023-12-31'
            },
            {
                id: 5,
                name: 'Clean Energy Initiative',
                description: 'Funding for sustainable energy projects',
                department: 'CE',
                eligibility: 'Students working on renewable energy',
                startDate: '2024-03-01',
                deadline: '2024-05-31',
                status: 'upcoming',
                applicationLink: 'https://university.edu/clean-energy',
                imageUrl: '',
                lastUpdated: '2024-02-10'
            }
        ];

        // Demo data for coordinators
        const defaultCoordinators = [
            { id: 1, name: 'Arun Kumar', club: 'Robotics Club' },
            { id: 2, name: 'Priya Sharma', club: 'Debate Society' },
            { id: 3, name: 'Rahul Verma', club: 'Photography Club' },
            { id: 4, name: 'Sneha Patel', club: 'Music Club' },
            { id: 5, name: 'Vikram Singh', club: 'Sports Club' }
        ];

        // Current user simulation (null = admin, number = coordinator ID)
        let currentUserId = null;

        // Demo data for permissions
        const defaultPermissions = [
            { coordinatorId: 1, schemeIds: [1, 2], status: 'granted' },
            { coordinatorId: 2, schemeIds: [3], status: 'granted' },
            { coordinatorId: 3, schemeIds: [5], status: 'granted' }
        ];

        // State management
        let schemes = JSON.parse(localStorage.getItem('incubationSchemes')) || [...defaultSchemes];
        let permissions = JSON.parse(localStorage.getItem('incubationPermissions')) || [...defaultPermissions];
        let currentEditingScheme = null;
        let currentEditingPermission = null;
        let selectedSchemesForPermission = [];

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            if (document.getElementById('section-incubation')) {
                renderSchemes();
                renderPermissions();
                updateSummaryCards();
                
                // Populate coordinator dropdown
                const coordinatorSelect = document.getElementById('permission-coordinator');
                if (coordinatorSelect) {
                    coordinatorSelect.innerHTML = '<option value="">Select Coordinator</option>' +
                        defaultCoordinators.map(c => `<option value="${c.id}">${c.name} - ${c.club}</option>`).join('');
                }
            }
        });

        // Tab switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById('tab-' + tabName).classList.add('active');
        }

        // Render schemes table
        function renderSchemes(filteredSchemes = null) {
            const tbody = document.getElementById('schemes-table-body');
            const schemesToRender = filteredSchemes || schemes;
            
            // Check if current user is coordinator
            const isCoordinator = currentUserId !== null;
            const userPermission = isCoordinator ? permissions.find(p => p.coordinatorId === currentUserId) : null;
            
            tbody.innerHTML = schemesToRender.map(scheme => {
                // Check if coordinator can edit this scheme
                const canEdit = !isCoordinator || (userPermission && userPermission.schemeIds.includes(scheme.id));
                const canDelete = !isCoordinator; // Only admin can delete
                
                return `
                    <tr>
                        <td><strong>${scheme.name}</strong></td>
                        <td>${scheme.department}</td>
                        <td>${formatDate(scheme.startDate)} - ${formatDate(scheme.deadline)}</td>
                        <td><span class="status-badge status-badge-${scheme.status}">${capitalizeFirst(scheme.status)}</span></td>
                        <td>${formatDate(scheme.lastUpdated)}</td>
                        <td>
                            <a href="#" class="action-link" onclick="viewScheme(${scheme.id})">View</a>
                            ${canEdit ? `<a href="#" class="action-link" onclick="editScheme(${scheme.id})">Edit</a>` : ''}
                            ${canDelete ? `<a href="#" class="action-link" onclick="deleteScheme(${scheme.id})">Delete</a>` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Render permissions table
        function renderPermissions() {
            const tbody = document.getElementById('permissions-table-body');
            const permissionActions = document.getElementById('permission-actions');
            
            // Coordinators cannot manage permissions
            if (currentUserId !== null) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--color-gray-medium);">Access Denied: Only administrators can manage coordinator permissions</td></tr>';
                if (permissionActions) {
                    permissionActions.style.display = 'none';
                }
                return;
            }
            
            if (permissionActions) {
                permissionActions.style.display = 'flex';
            }
            
            tbody.innerHTML = permissions.map(perm => {
                const coordinator = defaultCoordinators.find(c => c.id === perm.coordinatorId);
                const assignedSchemes = schemes.filter(s => perm.schemeIds.includes(s.id));
                const schemeNames = assignedSchemes.map(s => s.name).join(', ') || 'None';
                
                return `
                    <tr>
                        <td>${coordinator ? coordinator.name : 'Unknown'}</td>
                        <td>${coordinator ? coordinator.club : 'Unknown'}</td>
                        <td style="max-width: 300px;">${schemeNames}</td>
                        <td><span class="status-badge status-badge-${perm.status}">${capitalizeFirst(perm.status)}</span></td>
                        <td>
                            <a href="#" class="action-link" onclick="editPermission(${perm.coordinatorId})">Edit</a>
                            <a href="#" class="action-link" onclick="revokePermission(${perm.coordinatorId})">Revoke</a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Update summary cards
        function updateSummaryCards() {
            document.getElementById('total-schemes').textContent = schemes.length;
            document.getElementById('active-schemes').textContent = schemes.filter(s => s.status === 'active').length;
            document.getElementById('upcoming-schemes').textContent = schemes.filter(s => s.status === 'upcoming').length;
            document.getElementById('expired-schemes').textContent = schemes.filter(s => s.status === 'expired').length;
        }

        // Filter schemes
        function filterSchemes() {
            const searchTerm = document.getElementById('scheme-search').value.toLowerCase();
            const statusFilter = document.getElementById('scheme-status-filter').value;
            const deptFilter = document.getElementById('scheme-dept-filter').value;

            const filtered = schemes.filter(scheme => {
                const matchesSearch = scheme.name.toLowerCase().includes(searchTerm) ||
                                     scheme.description.toLowerCase().includes(searchTerm);
                const matchesStatus = statusFilter === 'all' || scheme.status === statusFilter;
                const matchesDept = deptFilter === 'all' || scheme.department === deptFilter;
                
                return matchesSearch && matchesStatus && matchesDept;
            });

            renderSchemes(filtered);
        }

        // Open scheme modal
        function openSchemeModal(schemeId = null) {
            const modal = document.getElementById('scheme-modal');
            const title = document.getElementById('scheme-modal-title');
            
            if (schemeId) {
                currentEditingScheme = schemes.find(s => s.id === schemeId);
                title.textContent = 'Edit Scheme';
                populateSchemeForm(currentEditingScheme);
            } else {
                currentEditingScheme = null;
                title.textContent = 'Add New Scheme';
                clearSchemeForm();
            }
            
            modal.classList.add('active');
        }

        // View scheme
        function viewScheme(schemeId) {
            const scheme = schemes.find(s => s.id === schemeId);
            if (!scheme) return;

            const modal = document.getElementById('view-scheme-modal');
            document.getElementById('view-scheme-name').textContent = scheme.name;
            document.getElementById('view-scheme-description').textContent = scheme.description;
            document.getElementById('view-scheme-department').textContent = scheme.department;
            document.getElementById('view-scheme-eligibility').textContent = scheme.eligibility;
            document.getElementById('view-scheme-period').textContent = `${formatDate(scheme.startDate)} - ${formatDate(scheme.deadline)}`;
            document.getElementById('view-scheme-status').textContent = capitalizeFirst(scheme.status);
            document.getElementById('view-scheme-link').textContent = scheme.applicationLink || 'Not provided';
            document.getElementById('view-scheme-link').href = scheme.applicationLink || '#';
            
            modal.classList.add('active');
        }

        // Edit scheme
        function editScheme(schemeId) {
            // Check if current user is a coordinator with permission
            if (currentUserId !== null) {
                const userPermission = permissions.find(p => p.coordinatorId === currentUserId);
                if (!userPermission || !userPermission.schemeIds.includes(schemeId)) {
                    showToast('Access Denied: You do not have permission to edit this scheme', 'error');
                    return;
                }
            }
            openSchemeModal(schemeId);
        }

        // Delete scheme
        function deleteScheme(schemeId) {
            // Coordinators cannot delete schemes
            if (currentUserId !== null) {
                showToast('Access Denied: Coordinators cannot delete schemes', 'error');
                return;
            }
            
            if (confirm('Are you sure you want to delete this scheme? This action cannot be undone.')) {
                schemes = schemes.filter(s => s.id !== schemeId);
                saveSchemes();
                renderSchemes();
                renderPermissions();
                updateSummaryCards();
                showToast('Scheme deleted successfully', 'success');
            }
        }

        // Populate scheme form
        function populateSchemeForm(scheme) {
            document.getElementById('scheme-name').value = scheme.name;
            document.getElementById('scheme-description').value = scheme.description;
            document.getElementById('scheme-department').value = scheme.department;
            document.getElementById('scheme-eligibility').value = scheme.eligibility;
            document.getElementById('scheme-start-date').value = scheme.startDate;
            document.getElementById('scheme-deadline').value = scheme.deadline;
            document.getElementById('scheme-status').value = scheme.status;
            document.getElementById('scheme-link').value = scheme.applicationLink || '';
            document.getElementById('scheme-image').value = scheme.imageUrl || '';
        }

        // Clear scheme form
        function clearSchemeForm() {
            document.getElementById('scheme-name').value = '';
            document.getElementById('scheme-description').value = '';
            document.getElementById('scheme-department').value = 'CSE';
            document.getElementById('scheme-eligibility').value = '';
            document.getElementById('scheme-start-date').value = '';
            document.getElementById('scheme-deadline').value = '';
            document.getElementById('scheme-status').value = 'upcoming';
            document.getElementById('scheme-link').value = '';
            document.getElementById('scheme-image').value = '';
        }

        // Save scheme
        function saveScheme() {
            const name = document.getElementById('scheme-name').value.trim();
            const description = document.getElementById('scheme-description').value.trim();
            const department = document.getElementById('scheme-department').value;
            const eligibility = document.getElementById('scheme-eligibility').value.trim();
            const startDate = document.getElementById('scheme-start-date').value;
            const deadline = document.getElementById('scheme-deadline').value;
            const status = document.getElementById('scheme-status').value;
            const applicationLink = document.getElementById('scheme-link').value.trim();
            const imageUrl = document.getElementById('scheme-image').value.trim();

            // Validation
            if (!name || !description || !eligibility || !startDate || !deadline) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            if (new Date(deadline) < new Date(startDate)) {
                showToast('Application deadline cannot be earlier than start date', 'error');
                return;
            }

            if (currentEditingScheme) {
                // Update existing scheme
                const index = schemes.findIndex(s => s.id === currentEditingScheme.id);
                schemes[index] = {
                    ...schemes[index],
                    name,
                    description,
                    department,
                    eligibility,
                    startDate,
                    deadline,
                    status,
                    applicationLink,
                    imageUrl,
                    lastUpdated: new Date().toISOString().split('T')[0]
                };
                showToast('Scheme updated successfully', 'success');
            } else {
                // Add new scheme
                const newScheme = {
                    id: Date.now(),
                    name,
                    description,
                    department,
                    eligibility,
                    startDate,
                    deadline,
                    status,
                    applicationLink,
                    imageUrl,
                    lastUpdated: new Date().toISOString().split('T')[0]
                };
                schemes.push(newScheme);
                showToast('Scheme added successfully', 'success');
            }

            saveSchemes();
            renderSchemes();
            updateSummaryCards();
            closeSchemeModal();
        }

        // Close scheme modal
        function closeSchemeModal() {
            document.getElementById('scheme-modal').classList.remove('active');
            currentEditingScheme = null;
        }

        // Open permission modal
        function openPermissionModal(coordinatorId = null) {
            const modal = document.getElementById('permission-modal');
            const title = document.getElementById('permission-modal-title');
            
            // Populate coordinator dropdown
            const coordinatorSelect = document.getElementById('permission-coordinator');
            coordinatorSelect.innerHTML = '<option value="">Select Coordinator</option>' +
                defaultCoordinators.map(c => `<option value="${c.id}">${c.name} - ${c.club}</option>`).join('');
            
            // Populate scheme dropdown
            const schemeDropdown = document.getElementById('scheme-dropdown');
            schemeDropdown.innerHTML = schemes.map(s => `
                <div class="multi-select-option" onclick="selectSchemeForPermission(${s.id})">
                    ${s.name} (${s.department})
                </div>
            `).join('');
            
            if (coordinatorId) {
                currentEditingPermission = permissions.find(p => p.coordinatorId === coordinatorId);
                title.textContent = 'Edit Coordinator Permissions';
                populatePermissionForm(currentEditingPermission);
            } else {
                currentEditingPermission = null;
                title.textContent = 'Grant Coordinator Access';
                clearPermissionForm();
            }
            
            modal.classList.add('active');
        }

        // Edit permission
        function editPermission(coordinatorId) {
            openPermissionModal(coordinatorId);
        }

        // Revoke permission
        function revokePermission(coordinatorId) {
            if (confirm('Are you sure you want to revoke this coordinator\'s access?')) {
                permissions = permissions.filter(p => p.coordinatorId !== coordinatorId);
                savePermissions();
                renderPermissions();
                showToast('Permission revoked successfully', 'success');
            }
        }

        // Populate permission form
        function populatePermissionForm(perm) {
            document.getElementById('permission-coordinator').value = perm.coordinatorId;
            selectedSchemesForPermission = [...perm.schemeIds];
            renderSelectedSchemes();
        }

        // Clear permission form
        function clearPermissionForm() {
            document.getElementById('permission-coordinator').value = '';
            selectedSchemesForPermission = [];
            renderSelectedSchemes();
        }

        // Render selected schemes tags
        function renderSelectedSchemes() {
            const container = document.getElementById('selected-schemes-container');
            container.innerHTML = selectedSchemesForPermission.map(schemeId => {
                const scheme = schemes.find(s => s.id === schemeId);
                return `
                    <span class="scheme-tag">
                        ${scheme ? scheme.name : 'Unknown'}
                        <span class="scheme-tag-remove" onclick="removeSchemeFromPermission(${schemeId})">×</span>
                    </span>
                `;
            }).join('');
        }

        // Remove scheme from permission
        function removeSchemeFromPermission(schemeId) {
            selectedSchemesForPermission = selectedSchemesForPermission.filter(id => id !== schemeId);
            renderSelectedSchemes();
        }

        // Toggle scheme selection dropdown
        function toggleSchemeDropdown() {
            const dropdown = document.getElementById('scheme-dropdown');
            // Refresh dropdown content
            dropdown.innerHTML = schemes.map(s => `
                <div class="multi-select-option ${selectedSchemesForPermission.includes(s.id) ? 'selected' : ''}" 
                     onclick="selectSchemeForPermission(${s.id})">
                    ${s.name} (${s.department})
                </div>
            `).join('');
            dropdown.classList.toggle('active');
        }

        // Select scheme for permission
        function selectSchemeForPermission(schemeId) {
            if (!selectedSchemesForPermission.includes(schemeId)) {
                selectedSchemesForPermission.push(schemeId);
                renderSelectedSchemes();
            }
            document.getElementById('scheme-dropdown').classList.remove('active');
        }

        // Save permission
        function savePermission() {
            const coordinatorId = parseInt(document.getElementById('permission-coordinator').value);
            
            if (!coordinatorId) {
                showToast('Please select a coordinator', 'error');
                return;
            }

            if (selectedSchemesForPermission.length === 0) {
                showToast('Please select at least one scheme', 'error');
                return;
            }

            if (currentEditingPermission) {
                // Update existing permission
                const index = permissions.findIndex(p => p.coordinatorId === coordinatorId);
                permissions[index] = {
                    ...permissions[index],
                    schemeIds: selectedSchemesForPermission,
                    status: 'granted'
                };
                showToast('Permissions updated successfully', 'success');
            } else {
                // Add new permission
                permissions.push({
                    coordinatorId,
                    schemeIds: selectedSchemesForPermission,
                    status: 'granted'
                });
                showToast('Access granted successfully', 'success');
            }

            savePermissions();
            renderPermissions();
            closePermissionModal();
        }

        // Close permission modal
        function closePermissionModal() {
            document.getElementById('permission-modal').classList.remove('active');
            currentEditingPermission = null;
            selectedSchemesForPermission = [];
        }

        // Close view scheme modal
        function closeViewSchemeModal() {
            document.getElementById('view-scheme-modal').classList.remove('active');
        }

        // Save to localStorage
        function saveSchemes() {
            localStorage.setItem('incubationSchemes', JSON.stringify(schemes));
        }

        function savePermissions() {
            localStorage.setItem('incubationPermissions', JSON.stringify(permissions));
        }

        // Reset demo data
        function resetDemoData() {
            if (confirm('Are you sure you want to reset all demo data? This will restore the initial demonstration schemes and permissions.')) {
                schemes = [...defaultSchemes];
                permissions = [...defaultPermissions];
                currentUserId = null;
                saveSchemes();
                savePermissions();
                renderSchemes();
                renderPermissions();
                updateSummaryCards();
                showToast('Demo data reset successfully', 'success');
            }
        }

        // Simulate user role (for testing permissions)
        function simulateUserRole(userId) {
            currentUserId = userId;
            const addSchemeBtn = document.getElementById('add-scheme-btn');
            
            if (userId === null) {
                showToast('Switched to Admin view', 'success');
                if (addSchemeBtn) addSchemeBtn.style.display = 'inline-flex';
            } else {
                const coordinator = defaultCoordinators.find(c => c.id === userId);
                showToast(`Switched to Coordinator view: ${coordinator.name}`, 'success');
                if (addSchemeBtn) addSchemeBtn.style.display = 'none';
            }
            renderSchemes();
            renderPermissions();
        }

        // Utility functions
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.multi-select-container')) {
                const dropdown = document.getElementById('scheme-dropdown');
                if (dropdown) {
                    dropdown.classList.remove('active');
                }
            }
        });

