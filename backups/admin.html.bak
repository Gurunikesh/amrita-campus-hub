        // ========================================
        // Modal Management
        // ========================================
        
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        // ========================================
        // Students Management
        // ========================================
        
        let currentEditingStudent = null;

        function renderStudents() {
            const tbody = document.getElementById('students-table-body');
            if (!tbody) return;
            
            tbody.innerHTML = students.map(student => `
                <tr>
                    <td>${student.name}</td>
                    <td>${student.roll}</td>
                    <td>${student.department}</td>
                    <td>${student.year}</td>
                    <td><span class="status-badge status-${student.status}">${capitalizeFirst(student.status)}</span></td>
                    <td>
                        <a href="#" class="action-link" onclick="viewStudent(${student.id})">View</a>
                        <a href="#" class="action-link" onclick="editStudent(${student.id})">Edit</a>
                        <a href="#" class="action-link" onclick="deleteStudent(${student.id})">Delete</a>
                    </td>
                </tr>
            `).join('');
        }

        function openStudentModal(studentId = null) {
            currentEditingStudent = studentId ? students.find(s => s.id === studentId) : null;
            document.getElementById('student-modal-title').textContent = currentEditingStudent ? 'Edit Student' : 'Add Student';
            
            if (currentEditingStudent) {
                document.getElementById('student-name').value = currentEditingStudent.name;
                document.getElementById('student-roll').value = currentEditingStudent.roll;
                document.getElementById('student-email').value = currentEditingStudent.email || '';
                document.getElementById('student-department').value = currentEditingStudent.department;
                document.getElementById('student-year').value = currentEditingStudent.year;
                document.getElementById('student-status').value = currentEditingStudent.status;
            } else {
                document.getElementById('student-name').value = '';
                document.getElementById('student-roll').value = '';
                document.getElementById('student-email').value = '';
                document.getElementById('student-department').value = 'CSE';
                document.getElementById('student-year').value = '1st Year / 1st Sem';
                document.getElementById('student-status').value = 'active';
            }
            
            openModal('student-modal');
        }

        function closeStudentModal() {
            closeModal('student-modal');
            currentEditingStudent = null;
        }

        function saveStudent() {
            const name = document.getElementById('student-name').value.trim();
            const roll = document.getElementById('student-roll').value.trim();
            const email = document.getElementById('student-email').value.trim();
            const department = document.getElementById('student-department').value;
            const year = document.getElementById('student-year').value;
            const status = document.getElementById('student-status').value;

            if (!name || !roll || !department || !year) {
                showToast('Please fill in all required fields', 'error');
                return;
            }

            if (currentEditingStudent) {
                const index = students.findIndex(s => s.id === currentEditingStudent.id);
                students[index] = { ...students[index], name, roll, email, department, year, status };
                showToast('Student updated successfully', 'success');
            } else {
                students.push({ id: Date.now(), name, roll, email, department, year, status });
                showToast('Student added successfully', 'success');
            }

            renderStudents();
            closeStudentModal();
        }

        function viewStudent(id) {
            const student = students.find(s => s.id === id);
            if (!student) return;
            alert(`Student Details:\n\nName: ${student.name}\nRoll Number: ${student.roll}\nEmail: ${student.email || 'N/A'}\nDepartment: ${student.department}\nYear: ${student.year}\nStatus: ${capitalizeFirst(student.status)}`);
        }

        function editStudent(id) {
            openStudentModal(id);
        }

        function deleteStudent(id) {
            if (confirm('Are you sure you want to delete this student?')) {
                students = students.filter(s => s.id !== id);
                renderStudents();
                showToast('Student deleted successfully', 'success');
            }
        }

        function openImportStudentsModal() {
            openModal('import-students-modal');
            document.getElementById('csv-file-input').value = '';
        }

        function closeImportStudentsModal() {
            closeModal('import-students-modal');
        }

        function importStudents() {
            const fileInput = document.getElementById('csv-file-input');
            const file = fileInput.files[0];
            
            if (!file) {
                showToast('Please select a CSV file', 'error');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const text = e.target.result;
                const lines = text.split('\n');
                let imported = 0;
                
                lines.forEach((line, index) => {
                    if (index === 0) return; // Skip header
                    const parts = line.split(',');
                    if (parts.length >= 4) {
                        students.push({
                            id: Date.now() + index,
                            name: parts[0].trim(),
                            roll: parts[1].trim(),
                            email: parts[2].trim(),
                            department: parts[3].trim(),
                            year: parts[4] ? parts[4].trim() : '1st Year / 1st Sem',
                            status: parts[5] ? parts[5].trim() : 'active'
                        });
                        imported++;
                    }
                });
                
                renderStudents();
                closeImportStudentsModal();
                showToast(`Successfully imported ${imported} students`, 'success');
            };
            
            reader.readAsText(file);
        }

