                        <!-- Add Classroom Form Panel -->
                        <div class="form-panel">
                            <h4 class="form-panel-title">Add New Classroom</h4>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">Select Block</label>
                                    <select class="form-input">
                                        <option>Select Block</option>
                                        <option>BLK-A - Main Academic Block</option>
                                        <option>BLK-B - Engineering Block</option>
                                        <option>BLK-C - Science Block</option>
                                        <option>BLK-D - Administration Block</option>
                                        <option>BLK-E - Library Block</option>
                                    </select>
