                                        <td>CSE</td>
                                        <td><span class="status-badge status-active">Available</span></td>
                                        <td>
                                            <a href="#" class="action-link" onclick="viewClassroom(1)">View</a>
                                            <a href="#" class="action-link" onclick="editClassroom(1)">Edit</a>
                                            <a href="#" class="action-link" onclick="deleteClassroom(1)">Delete</a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>CR-102</td>
                                        <td>BLK-A</td>
                                        <td>1st Floor</td>
                                        <td>Lecture Hall</td>
                                        <td>120</td>
                                        <td>ECE</td>
                                        <td><span class="status-badge status-active">Available</span></td>
                                        <td>
                                            <a href="#" class="action-link" onclick="viewClassroom(2)">View</a>
                                            <a href="#" class="action-link" onclick="editClassroom(2)">Edit</a>
                                            <a href="#" class="action-link" onclick="deleteClassroom(2)">Delete</a>
                                        </td>
