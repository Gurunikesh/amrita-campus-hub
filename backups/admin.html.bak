                                    <label class="form-label">Department Allocation</label>
                                    <select class="form-input">
                                        <option>Select Department</option>
                                        <option>CSE</option>
                                        <option>ECE</option>
                                        <option>ME</option>
                                        <option>EE</option>
                                        <option>CE</option>
                                    </select>
